// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  GENERAL_PRACTITIONER @map("DOCTOR")
  MEDICAL_SPECIALIST
  SUB_SPECIALIST
  CLINICAL_NURSE @map("NURSE")
  SPECIALIZED_NURSE
  MIDWIFE
  HEALTH_EXTENSION_WORKER
  HEALTH_OFFICER
  LABORATORY_TECHNICIAN @map("LAB_TECH")
  LABORATORY_TECHNOLOGIST
  RADIOGRAPHER
  ANESTHETIST
  IESO
  PHARMACIST
  IT_HIS_ADMIN @map("HIS_ADMINISTRATOR")
  HOSPITAL_CEO @map("ADMIN")
  RECEPTIONIST
  CARD_ROOM_CLERK
  FINANCE_INSURANCE @map("FINANCE_OFFICER")
  AMBULANCE_DRIVER
  SECURITY_GUARD
  CLEANER
  SYSTEM_ADMINISTRATOR
}

enum FacilityOwnershipType {
  PUBLIC
  PRIVATE
}

enum FacilityServiceType {
  HEALTH_POST
  HEALTH_CENTER
  PRIMARY_HOSPITAL
  GENERAL_HOSPITAL
  SPECIALIZED_HOSPITAL
  REFERRAL_HOSPITAL
  PRIMARY_CLINIC
  SPECIALTY_CLINIC
}

enum AppointmentStatus {
  PENDING_CONFIRMATION
  SCHEDULED
  ARRIVED
  TRIAGED
  IN_CONSULTATION
  CANCELLED
}

enum AppointmentPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

// ─── Facility Onboarding Application Status ───────────────────────────────────
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

type BilingualContent {
  en String
  am String
}

model User {
  id              String @id @default(uuid()) @map("_id")
  email           String @unique
  emailOrUsername String? @unique
  passwordHash    String?
  role            Role   @default(RECEPTIONIST)

  firstName                 String?
  lastName                  String?
  fullName                  String?
  professionalLicenseNumber String?
  specialization            String?
  hospitalId                String? @map("hospital_id")
  hospitalName              String?

  nationalId String? @unique
  otpCode    String?

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  isActive           Boolean @default(true)
  canApproveAccounts Boolean @default(false)
  canManageUsers     Boolean @default(false)
  canViewReports     Boolean @default(false)

  // ── Password reset workflow ──────────────────────────────────────────────
  isTempPassword    Boolean   @default(false)
  resetRequestCode  String?
  passwordChangedAt DateTime?

  // ── First-time login password initialization ──────────────────────────────
  isFirstLogin      Boolean   @default(true)
  activationCode    String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  assignedWardId String?       @map("assigned_ward_id")
  assignedWard   ClinicalWard? @relation(fields: [assignedWardId], references: [id])

  investigations        Investigation[]
  accessLogs            AccessLog[]
  medicalAuditLogs      MedicalAuditLog[]
  diagnosticOrdersReferred DiagnosticOrder[]
  referralSummaries     ReferralSummary[]
  verificationAttempts  VerificationAttempt[]
}

enum Ward {
  OPD_OUTPATIENT            @map("OPD / Outpatient")
  EMERGENCY                 @map("Emergency")
  MEDICAL_WARD              @map("Medical Ward")
  SURGICAL_WARD             @map("Surgical Ward")
  MATERNITY_WARD            @map("Maternity Ward")
  GYNECOLOGY                @map("Gynecology")
  PEDIATRIC_WARD            @map("Pediatric Ward")
  NEWBORN_NEONATAL          @map("Newborn / Neonatal")
  INPATIENT_GENERAL_WARD    @map("Inpatient / General Ward")
  LABORATORY                @map("Laboratory")
  PHARMACY                  @map("Pharmacy")
  PROCEDURE_MINOR_OPERATION @map("Procedure / Minor Operation")
  ISOLATION                 @map("Isolation")
  SUPPORT_UNITS             @map("Support Units")
}

enum TriageStatus {
  RED
  YELLOW
  GREEN
  WAITING_FOR_TRIAGE
}

enum PriorityLevel {
  EMERGENCY
  URGENT
  ROUTINE
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Result of a structured clinical screening (Green / Yellow / Red).
enum ScreeningTriageLevel {
  GREEN
  YELLOW
  RED
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

model Patient {
  id            String  @id @default(uuid()) @map("_id")
  healthId      String  @unique
  nationalId    String?
  faydaId       String? @map("fayda_id")
  hospitalId    String? @map("hospital_id")
  fcn           String? @map("fcn")
  internalId    String  @unique @map("internal_id")
  isMinor       Boolean @default(false)
  guardianId    String?
  parentFaydaId String? @map("parent_fayda_id")
  isSynced      Boolean @default(false)
  email         String?
  passwordHash  String?   // Direct password auth (set at registration or via reset)
  isVerified    Boolean   @default(true)
  registrationSource String @default("RECEPTION")
  otpCode       String?
  otpExpiresAt  DateTime? // OTP is valid for 5 minutes from generation

  // Queue Information
  phoneNumber   String?
  queuePosition Int     @default(0)
  estimatedWait Int     @default(0)

  // 1. Patient Registration Data (From DATA 1)
  fullName          String
  age               Int
  sex               String
  religion          String?
  occupation        String?
  maritalStatus     String?
  educationalStatus String?
  dateOfAdmission   DateTime @default(now())

  // Address broken down
  address Address?

  dateOfBirth DateTime?

  // Contacts
  emergencyContactName  String?
  emergencyContactPhone String?

  // Smart Fields
  chiefComplaint        String?
  detailedSituation     String?
  reasonForVisit        String?
  suspectedDisease      String?
  preExistingConditions String?
  familyHistory         String?
  surgicalHistory       String?
  allergyInformation    String?
  /// Medical Record Number (hospital chart); distinct from healthId when assigned.
  mrn                   String?
  bloodGroup            String?
  emergencyFlag         Boolean @default(false)
  isRestricted          Boolean @default(false) @map("is_restricted")
  isHistoryPublic       Boolean @default(false) @map("is_history_public")
  externalSystemId      String?
  legacyProviderName    String?
  serviceType           String? @default("OPD")

  ward          Ward          @default(OPD_OUTPATIENT)
  triageStatus  TriageStatus  @default(WAITING_FOR_TRIAGE)
  priorityLevel PriorityLevel @default(ROUTINE)
  examStatus    String        @default("PENDING")
  status        String?       @default("ACTIVE")

  // AI Smart Triage Engine — persisted once, shared across all wards
  aiPriorityScore  Float?  @map("ai_priority_score") // 0-100
  aiRecommendation String? @map("ai_recommendation") // JSON string
  aiSymptomSummary String? @map("ai_symptom_summary") // For the Doctor's Command Center

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vitals          Vitals[]
  investigations  Investigation[]
  prescriptions   Prescription[]
  referrals       Referral[]
  clinicalExam    ClinicalExamination?
  queues          Queue[]
  accessLogs      AccessLog[]
  medicalAuditLogs MedicalAuditLog[]
  diagnosticOrders DiagnosticOrder[]
  journals        PatientJournal[]
  screenings      Screening[]
  medicalTimeline MedicalTimelineEntry[]
  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  referralSummaries ReferralSummary[]
  labRequests     LabRequest[]
  verificationAttempts VerificationAttempt[]
  patientIdentityAudits PatientIdentityAudit[]

  @@index([nationalId])
  @@index([faydaId])
  @@index([hospitalId])
  @@index([fcn])
}

/// Append-only clinical timeline (never update rows — new facts = new documents).
enum MedicalTimelineEntryType {
  SECTION_NOTE
  VITALS
  NURSING_PROGRESS
  SYSTEMS_EXAM
}

model VerifiedRegistry {
  id          String   @id @default(uuid()) @map("_id")
  fin         String   @unique
  fcn         String   @unique
  fullName    String
  dateOfBirth DateTime
  gender      String

  // Optional: store source record metadata
  issuedAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("verified_registry")
}

/// Permanent registration snapshot for staff lookup by FIN or phone (national intake).
model VerifiedCitizen {
  id          String   @id @default(uuid()) @map("_id")
  nationalFin String?  @unique @map("national_fin")
  phoneDigits String?  @unique @map("phone_digits")
  fullName    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("verified_citizens")
}

model ClinicalExamination {
  id             String  @id @default(uuid()) @map("_id")
  patientId      String  @unique
  organizationId String? @map("organization_id")

  generalAppearance String?
  heent             String?
  lymphoglandular   String?
  respiratory       String?
  cardiovascular    String?
  abdomen           String?
  genitourinary     String?
  musculoskeletal   String?
  integumentary     String?
  neurological      String?

  clinicalNotes String? // Final impressions

  // Doctor Assessment Fields
  chiefAssessment       String? @map("chief_assessment")
  workingDiagnosis      String? @map("working_diagnosis")
  differentialDiagnosis String? @map("differential_diagnosis")
  progressNotes         String? @map("progress_notes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Vitals {
  id        String @id @default(uuid()) @map("_id")
  patientId String

  organizationId String? @map("organization_id")
  // Mandatory Vital Signs
  bp             String // Blood Pressure e.g., "120/80"
  pulse          Int // Pulse Rate (PR)
  rr             Int // Respiratory Rate (RR)
  temp           Float // Temperature (T°)
  spO2           Float // Blood Oxygen
  bmi            Float? // Body Mass Index
  painLevel      Int? // Pain Level 1-10
  weightKg       Float?
  heightCm       Float?

  createdAt DateTime @default(now())

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model MedicalTimelineEntry {
  id               String                   @id @default(uuid()) @map("_id")
  organizationId   String?                  @map("organization_id")
  patientId        String
  createdAt        DateTime                 @default(now())
  professionalName String
  /// One-line immutable audit summary (searchable list).
  logEntry         String
  entryType        MedicalTimelineEntryType
  /// One of: identification | past_history | vitals | clinical_exam | nursing_progress | investigations | medications | referrals
  emrSection       String
  title            String?
  body             String?
  structuredData   Json?
  relatedVitalsId  String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([patientId, emrSection])
  @@index([organizationId])
  @@map("medical_timeline_entries")
}

model MedicalAuditLog {
  id                  String                  @id @default(uuid()) @map("_id")
  userId              String
  organizationId      String                  @map("organization_id")
  employeeName        String
  employeeRole        Role?
  facilityServiceType FacilityServiceType?
  patientId           String
  actionType          MedicalAuditLogAction
  emergency           Boolean                 @default(false)
  metadata            Json?
  createdAt           DateTime                @default(now())

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId, patientId])
  @@index([userId, createdAt])
  @@index([patientId, createdAt])
  @@map("medical_audit_logs")
}

enum InvestigationStatus {
  PENDING
  COMPLETED
}

enum RoutingStatus {
  INTERNAL
  PENDING_EXTERNAL_DISPATCH
  ACCEPTED_BY_EXTERNAL
  COMPLETED_EXTERNAL
  REJECTED_BY_EXTERNAL
}

model Investigation {
  id             String  @id @default(uuid()) @map("_id")
  patientId      String
  doctorId       String?
  organizationId String? @map("organization_id")

  testName   String
  category   String?
  department String?

  status InvestigationStatus @default(PENDING)
  result String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User?   @relation(fields: [doctorId], references: [id])
  diagnosticOrder DiagnosticOrder? @relation("InvestigationToOrder")
}

model DiagnosticOrder {
  id                        String         @id @default(uuid()) @map("_id")
  patientId                 String
  investigationId           String?        @unique @map("investigation_id")
  originOrganizationId      String         @map("origin_organization_id")
  destinationOrganizationId String?        @map("destination_organization_id")
  referredByUserId          String         @map("referred_by_user_id")
  
  routingStatus             RoutingStatus  @default(INTERNAL)
  
  /// Diagnostic test name/description for cross-facility ordering
  diagnosticType            String
  /// Priority level for expedited processing
  priority                  String?        @default("ROUTINE")
  /// Clinical indication for the diagnostic test
  clinicalIndication        String?
  /// Expected turnaround time for results
  expectedTurnaroundTime    String?
  
  /// Structured test parameters/specimen requirements
  orderDetails              Json?
  /// Notes from destination facility (acceptance/rejection reason)
  destinationNotes          String?
  
  createdAt                 DateTime       @default(now())
  acceptedAt                DateTime?
  completedAt               DateTime?
  updatedAt                 DateTime       @updatedAt

  // Relations
  patient              Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  investigation        Investigation? @relation("InvestigationToOrder", fields: [investigationId], references: [id], onDelete: SetNull)
  originOrganization   Organization @relation("DiagnosticOrderOrigin", fields: [originOrganizationId], references: [id], onDelete: Cascade)
  destinationOrganization Organization? @relation("DiagnosticOrderDestination", fields: [destinationOrganizationId], references: [id], onDelete: SetNull)
  referredByUser       User         @relation(fields: [referredByUserId], references: [id], onDelete: Cascade)

  @@index([patientId, routingStatus])
  @@index([originOrganizationId, createdAt])
  @@index([destinationOrganizationId, routingStatus])
  @@index([referredByUserId, createdAt])
  @@map("diagnostic_orders")
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
}

model Prescription {
  id             String  @id @default(uuid()) @map("_id")
  patientId      String
  doctorId       String?
  organizationId String? @map("organization_id")

  drugName  String  @map("medication")
  dosage    String
  frequency String  @default("N/A")
  duration  String  @default("N/A")
  notes     String?

  status PrescriptionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Referral {
  id        String @id @default(uuid()) @map("_id")
  patientId String

  reason                String
  destinationFacility   String
  receivingFacilityId   String?        @map("receiving_facility_id")
  sourceFacilityId      String?        @map("source_facility_id")
  targetFacilityId      String?        @map("target_facility_id")
  clinicalUrgency       String?        @map("clinical_urgency")
  provisionalDiagnosis  String?        @map("provisional_diagnosis")
  status                ReferralStatus @default(PENDING)
  rejectionReason       String?        @map("rejection_reason")
  aiOverrideLogged      Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([receivingFacilityId])
}

model SystemSettings {
  id          String   @id @default(uuid()) @map("_id")
  isBreakTime Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Queue {
  id          String      @id @default(uuid()) @map("_id")
  patientId   String
  status      QueueStatus @default(WAITING)
  checkInTime DateTime    @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

enum AccessLogAction {
  VIEW
  BREAK_GLASS
  RESTRICT
  UNRESTRICT
}

enum MedicalAuditLogAction {
  VIEW_TIMELINE
  VIEW_RECORD
  OVERRIDE_PRIVACY
  BREAK_GLASS
  DOWNLOAD_RECORD
  CROSS_FACILITY_ACCESS
  OTHER
}

model AccessLog {
  id                  String          @id @default(uuid()) @map("_id")
  patientId           String
  organizationId      String?         @map("organization_id")
  userId              String?         @map("user_id")
  accessedByName      String
  facilityServiceType FacilityServiceType?
  role                Role?
  action              AccessLogAction @default(VIEW)
  createdAt           DateTime        @default(now())

  // Relations
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model PatientJournal {
  id        String @id @default(uuid()) @map("_id")
  patientId String

  symptoms String?
  mood     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

/// Structured multi-condition screening (TB, HTN, Diabetes, etc.) with raw answers + computed triage.
model Screening {
  id                   String               @id @default(uuid()) @map("_id")
  patientId            String
  screeningType        String
  answers              Json
  triageResult         ScreeningTriageLevel
  riskScore            Int                  @default(0)
  interruptedEmergency Boolean              @default(false)

  /// Bilingual post-screening guidance shown to the patient/staff.
  guidanceText Json?

  /// Vitals snapshot for Hypertension / Cardiac (history over repeat screenings).
  sbp      Float?
  dbp      Float?
  weightKg Float?
  heightCm Float?
  bmi      Float?

  bpStageLabel           String?
  diabetesInterpretation Json?
  computedDetails        Json?

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, screeningType])
  @@index([patientId, createdAt])
  @@map("screenings")
}

// ─── Facility Onboarding Application ────────────────────────────────────────
// Applicants (authenticated users) submit this before a facility is created.
// A SYSTEM_ADMINISTRATOR reviews and either approves (creating the Organization
// and linking the registeredBy user as initial admin) or rejects it.
// The metadata Json field intentionally stores all flexible verification
// artefacts so the core schema never needs additional columns for new
// document types (e.g. license_url, physician_lead_name, etc.).
model FacilityApplication {
  id                    String            @id @default(uuid()) @map("_id")
  status                ApplicationStatus @default(PENDING)

  // Business identity — unique per application
  businessLicenseNumber String            @unique @map("business_license_number")
  contactEmail          String            @map("contact_email")

  // Submitter — references User.id (not a Prisma relation to avoid cascade issues)
  registeredBy          String            @map("registered_by")

  // Facility details captured at apply-time
  officialName          String            @map("official_name")
  facilityType          String            @map("facility_type")   // FacilityServiceType string
  ownershipType         String?           @map("ownership_type")  // FacilityOwnershipType string
  region                String?
  zone                  String?
  woreda                String?
  kebele                String?

  // Flexible verification payload — store document links & extra fields here:
  // {
  //   license_url:           string,   // URL to uploaded business licence scan
  //   representative_id_type: string,  // e.g. "Passport", "Kebele ID"
  //   representative_id_url:  string,  // URL to uploaded representative ID scan
  //   physician_lead_name:   string,   // Name of the lead physician/director
  //   notes:                 string,   // Free-text applicant notes
  // }
  metadata              Json

  // Populated on approval
  approvedFacilityId    String?           @map("approved_facility_id")
  approvedAt            DateTime?         @map("approved_at")
  approvedBy            String?           @map("approved_by")

  // Populated on rejection
  rejectionReason       String?           @map("rejection_reason")

  createdAt             DateTime          @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([registeredBy])
  @@map("facility_applications")
}

model Organization {
  id             String                @id @default(uuid()) @map("_id")
  name           String
  nameLng        BilingualContent
  code           String                @unique
  registrationId String                @unique
  licenseNumber  String?
  ownershipType  FacilityOwnershipType
  serviceType    FacilityServiceType

  region           String? // Kilil
  zone             String?
  woreda           String?
  kebele           String?
  email            String?
  phone            String?
  website          String?
  isActive         Boolean   @default(true)
  isVerified       Boolean   @default(false)
  verificationCode String?
  verifiedAt       DateTime?
  registeredAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users                       User[]
  patients                    Patient[]
  appointments                Appointment[]
  departments                 Department[]
  services                    Service[]
  intakeRequests              IntakeRequest[]
  accessLogs                  AccessLog[]
  medicalAuditLogs            MedicalAuditLog[]
  diagnosticOrdersAsOrigin    DiagnosticOrder[] @relation("DiagnosticOrderOrigin")
  diagnosticOrdersAsDestination DiagnosticOrder[] @relation("DiagnosticOrderDestination")
  referralSummariesAsOrigin ReferralSummary[] @relation("ReferralSummaryOrigin")
  referralSummariesAsDestination ReferralSummary[] @relation("ReferralSummaryDestination")
  labRequests               LabRequest[]
  labTestTemplates           LabTestTemplate[]
  clinicalWards              ClinicalWard[]
  screeningQuestions        ScreeningQuestion[]
}

model Appointment {
  id              String            @id @default(uuid()) @map("_id")
  patientId       String            @map("patient_id")
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String?           @map("doctor_id")
  facilityId      String            @map("facility_id")
  facility        Organization      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  department      String
  dateTime        DateTime
  status          AppointmentStatus @default(PENDING_CONFIRMATION)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  chiefComplaints String?
  assignedWardId  String?           @map("assigned_ward_id")
  assignedWard    ClinicalWard?     @relation(fields: [assignedWardId], references: [id])
  metadata        Json?

  @@index([facilityId, patientId])
  @@index([facilityId, status])
  @@index([facilityId, dateTime])
}

model ClinicalWard {
  id           String        @id @default(uuid()) @map("_id")
  name         String
  code         String        @unique
  facilityId   String?       @map("facility_id")
  facility     Organization? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  type         String?
  appointments Appointment[]
  doctors      User[]
}


model MedicalRecord {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String   @map("organization_id")
  patientId      String   @map("patient_id")
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordType     String
  title          String
  content        String
  recordedBy     String?
  recordedAt     DateTime @default(now())

  @@index([organizationId, patientId])
  @@index([organizationId, recordType])
}

model Department {
  id             String            @id @default(uuid()) @map("_id")
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameLng        BilingualContent
  description    String?
  departmentCode String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  screeningOptions ScreeningOption[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ─── Pre-Booking Symptom Screening Engine ────────────────────────────────────
// Facility-scoped wizard questions shown to citizens before department selection.
// Multi-tenant: always scoped to organizationId.
// Bilingual: all labels stored in both English (en) and Amharic (am).

model ScreeningQuestion {
  id             String            @id @default(uuid()) @map("_id")
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Presentation order within the wizard (ascending)
  order          Int               @default(0)
  labelEn        String            @map("label_en")
  labelAm        String            @map("label_am")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  options        ScreeningOption[]

  @@index([organizationId, isActive])
  @@index([organizationId, order])
  @@map("screening_questions")
}

model ScreeningOption {
  id              String             @id @default(uuid()) @map("_id")
  questionId      String             @map("question_id")
  question        ScreeningQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  labelEn         String             @map("label_en")
  labelAm         String             @map("label_am")
  /// When true: halt the booking wizard and display the Emergency Room redirect alert.
  isEmergencyFlag Boolean            @default(false) @map("is_emergency_flag")
  /// When set: auto-select this department string and skip department selection step.
  /// Must match a value from the DEPARTMENTS constant in the client (free-text string).
  autoSelectDepartment String?       @map("auto_select_department")
  /// Presentation order within the question (ascending)
  order           Int                @default(0)
  /// Optional back-reference to a Department record for admin cross-referencing.
  departmentId    String?            @map("department_id")
  department      Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@map("screening_options")
}

model Service {
  id             String           @id @default(uuid()) @map("_id")
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameLng        BilingualContent
  description    String?
  serviceCode    String
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())

  @@unique([organizationId, serviceCode])
  @@index([organizationId])
}

model IntakeRequest {
  id             String       @id @default(uuid()) @map("_id")
  nationalId     String       @map("national_id")
  fullName       String       @map("full_name")
  phoneNumber    String?      @map("phone_number")
  notes          String?
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([nationalId])
}

type Address {
  region String?
  zone   String?
  woreda String?
  kebele String?
}

model ReferralSummary {
  id                         String   @id @default(uuid()) @map("_id")
  patientId                  String   @map("patient_id")
  originOrganizationId       String   @map("origin_organization_id")
  destinationOrganizationId  String?  @map("destination_organization_id")
  clinicalSnapshot           Json     @map("clinical_snapshot")
  issuedByUserId             String   @map("issued_by_user_id")
  createdAt                  DateTime @default(now()) @map("created_at")
  documentHash               String   @map("document_hash")

  // Relations
  patient                 Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  originOrganization      Organization  @relation("ReferralSummaryOrigin", fields: [originOrganizationId], references: [id], onDelete: Cascade)
  destinationOrganization Organization? @relation("ReferralSummaryDestination", fields: [destinationOrganizationId], references: [id], onDelete: SetNull)
  issuedByUser            User          @relation(fields: [issuedByUserId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([originOrganizationId])
  @@index([destinationOrganizationId])
  @@index([issuedByUserId])
  @@map("referral_summaries")
}

enum LabRequestStatus {
  PENDING
  SAMPLE_COLLECTED
  COMPLETED
  CANCELLED
}

model LabTestTemplate {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String   @map("organization_id")
  testName       String   @map("test_name")
  category       String
  unit           String
  normalLow      Float    @map("normal_low")
  normalHigh     Float    @map("normal_high")
  panicLow       Float    @map("panic_low")
  panicHigh      Float    @map("panic_high")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, testName])
  @@map("lab_test_templates")
}

model LabRequest {
  id             String           @id @default(uuid()) @map("_id")
  organizationId String           @map("organization_id")
  encounterId    String           @map("encounter_id")
  patientId      String           @map("patient_id")
  status         LabRequestStatus @default(PENDING)
  tests          String[]
  orderDate      DateTime         @default(now()) @map("order_date")
  completedDate  DateTime?        @map("completed_date")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  results        LabResultItem[]

  @@index([organizationId, status])
  @@index([patientId, orderDate])
  @@map("lab_requests")
}

model LabResultItem {
  id         String   @id @default(uuid()) @map("_id")
  requestId  String   @map("request_id")
  testName   String   @map("test_name")
  value      Float
  textValue  String?  @map("text_value")
  isAbnormal Boolean  @default(false) @map("is_abnormal")
  isCritical Boolean  @default(false) @map("is_critical")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  request    LabRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("lab_result_items")
}

model RateLimit {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  key      String   @unique
  points   Int      @default(0)
  expireAt DateTime

  @@index([expireAt])
  @@map("rate_limits")
}

model VerificationAttempt {
  id             String   @id @default(uuid()) @map("_id")
  patientId      String?  @map("patient_id")
  userId         String?  @map("user_id")
  otpHash        String   @map("otp_hash")
  purpose        String   @default("CITIZEN_LOGIN")
  expiresAt      DateTime @map("expires_at")
  attempts       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  channel        String   @default("SMS")
  deliveryStatus String   @default("PENDING")
  ipAddress      String?  @map("ip_address")

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([userId])
  @@map("verification_attempts")
}

model VerificationRateLimit {
  id         String   @id @default(uuid()) @map("_id")
  ipAddress  String   @map("ip_address")
  identifier String   @map("identifier")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ipAddress, createdAt])
  @@index([identifier, createdAt])
  @@map("verification_rate_limits")
}

model PatientIdentityAudit {
  id           String   @id @default(uuid()) @map("_id")
  patientId    String   @map("patient_id")
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fieldAltered String   @map("field_altered")
  oldValue     String   @map("old_value")
  newValue     String   @map("new_value")
  performedBy  String   @map("performed_by")
  facilityId   String?  @map("facility_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([patientId])
  @@map("patient_identity_audits")
}

// ─── Landing Page Media ─────────────────────────────────────────────────────
// Administrator-managed image carousel shown on the public landing page.
// Images are stored as URLs (cloud storage / public path).
model LandingMedia {
  id           String   @id @default(uuid()) @map("_id")
  imageUrl     String   @map("image_url")
  altText      String   @map("alt_text")
  title        String?
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  uploadedBy   String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@map("landing_media")
}

// ─── Bilingual Carousel Slides ───────────────────────────────────────────────
// System Administrator-managed bilingual hero slides shown on the public
// landing page. Both English and Amharic text variants are stored directly
// in each document to enable server-side locale switching without joins.
model CarouselSlide {
  id         String   @id @default(uuid()) @map("_id")
  imageUrl   String
  headingEn  String
  headingAm  String
  textEn     String
  textAm     String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
  @@map("carousel_slides")
}

// ─── System Administrator Audit Log ─────────────────────────────────────────
// Append-only log of all privileged actions performed by SYSTEM_ADMINISTRATOR.
model AuditLog {
  id          String   @id @default(uuid()) @map("_id")
  actorId     String   @map("actor_id")
  actorName   String   @map("actor_name")
  actorRole   String   @map("actor_role")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  targetName  String?  @map("target_name")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
